# Copy to .env (git-ignored) and fill in real values: cp .env.example .env
# Loaded with Node's built-in --env-file; validated at startup. Full list: document/api-requirements.md §12.

NODE_ENV=development
PORT=3000

# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgres://tcms_app_user:<password>@localhost:5432/tcms_app_db_dev

# Signs and verifies access tokens (HS256). At least 32 characters; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out (all issued tokens become invalid).
JWT_SECRET=<random-secret>
# Access token (and cookie) lifetime. Sign-out clears the cookie but can't revoke the token (no Redis
# denylist yet), so this is also how long an extracted token keeps working. Role, permissions and account
# status are read from the database on every request and apply immediately.
JWT_EXPIRES_IN_SECONDS=3600

# Outgoing email (user invitations). Development: Mailpit in Docker catches everything — inbox at
# http://localhost:8025, nothing reaches real people. Production: your email provider's SMTP endpoint, e.g.
#   smtps://<user>:<password>@email-smtp.<region>.amazonaws.com:465   (URL-encode special characters)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="TCMS <no-reply@tcms.local>"
# Where the UI runs — invitation links point to <UI_BASE_URL>/set-password.
UI_BASE_URL=http://localhost:5173

# Only for `npm run admin:create` (first admin's password, min 8 characters); the server never reads it.
# Use a different password per environment (development, each server).
INITIAL_ADMIN_PASSWORD=
